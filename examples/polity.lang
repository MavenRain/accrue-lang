-- The DAO (S6, Q-S6-9 (a)): G3 cast and tally, G4 amend tAppend, G5 amend
-- tAmend. The file is a guest: it names the domain defs only. The counts come
-- from len and opSucc, and the points and tags are head digests (no literal).
def zero : Option Count := len Point (fmUnit Point)
def one : Option Count := bind zero opSucc
def two : Option Count := bind one opSucc
def three : Option Count := bind two opSucc
def r0 : Record := fmUnit Entry
def k1 : Point := head r0
def r1 : Record := snoc k1 r0
def k2 : Point := head r1
def r2 : Record := snoc k2 r1
def k3 : Point := head r2
def r3 : Record := snoc k3 r2
def k4 : Point := head r3
def crew : FreeMon Point := fmMul Point (fmMul Point (fmEta Point k1) (fmEta Point k2)) (fmEta Point k3)
def s0 : Option Polity := bind two (fun (t : Count) => some (makePolity crew t t t k1 k2))
def pAppend : Option Proposal := bind three (fun (a : Count) => map (fun (t : Count) => makePolity crew a t t k1 k3) two)
def pLower : Option Proposal := bind two (fun (t : Count) => map (fun (u : Count) => makePolity crew t u t k1 k2) one)
def pOpen : Option Proposal := bind two (fun (t : Count) => bind one (fun (u : Count) => map (fun (h : Count) => makePolity crew t u h k1 k2) three))
def b1 : SealedBallot := mkBallot verdictYes k2
def b2 : SealedBallot := mkBallot verdictNo k3
def b3 : SealedBallot := mkBallot verdictYes k4
def box0 : Box := fmUnit SealedBallot
def box1 : Box := fmMul SealedBallot box0 (fmEta SealedBallot b1)
def box3 : Box := fmMul SealedBallot (fmMul SealedBallot box1 (fmEta SealedBallot b2)) (fmEta SealedBallot b3)

-- L6 (Q-S6-3 (a)) on closed boxes of 0, 1 and 3 ballots: the opened tally is
-- the count of the plain votes.
def l6Zero : (q : Quorum) -> Path (Option Count) (open (Option Count) q (tallyBox box0)) (countVotes (fmMap SealedBallot Verdict (fun (x : SealedBallot) => decrypt Verdict (ballotVote x)) box0)) :=
  fun (q : Quorum) => refl
def l6One : (q : Quorum) -> Path (Option Count) (open (Option Count) q (tallyBox box1)) (countVotes (fmMap SealedBallot Verdict (fun (x : SealedBallot) => decrypt Verdict (ballotVote x)) box1)) :=
  fun (q : Quorum) => refl
def l6Three : (q : Quorum) -> Path (Option Count) (open (Option Count) q (tallyBox box3)) (countVotes (fmMap SealedBallot Verdict (fun (x : SealedBallot) => decrypt Verdict (ballotVote x)) box3)) :=
  fun (q : Quorum) => refl
-- L7 (Q-S6-2 (a)): open is decrypt for each quorum and ciphertext.
def l7 : (q : Quorum) -> (c : Enc Count) -> Path Count (open Count q c) (decrypt Count c) :=
  fun (q : Quorum) (c : Enc Count) => refl
-- L8 on the closed s0 (tAmend two): a yes count of two meets the threshold,
-- so the step enacts p.
def l8 : (p : Proposal) -> Path (Option Polity) (bind s0 (fun (s : Polity) => map (fun (t : Count) => stepD s (pair p t)) two)) (some p) :=
  fun (p : Proposal) => refl
-- L9 (Q-S6-6 (a)): amendAll folds the left factor first.
def l9 : (ps : FreeMon Decided) -> (qs : FreeMon Decided) -> (s : Polity) -> Path Polity (amendAll (fmMul Decided ps qs) s) (amendAll qs (amendAll ps s)) :=
  fun (ps : FreeMon Decided) (qs : FreeMon Decided) (s : Polity) => refl

-- Eval rows: the tally of 0, 1 and 3 ballots, the plain count, a cast with a
-- used tag, decideYes at and below the threshold, G4, a refused amendment and
-- G5 (pLower lowers tAmend, so pOpen passes with one yes vote).
def tallyZero : Enc (Option Count) := tallyBox box0
def tallyOne : Enc (Option Count) := tallyBox box1
def tallyThree : Enc (Option Count) := tallyBox box3
def countThree : Option Count := countVotes (fmMul Verdict (fmMul Verdict (fmEta Verdict verdictYes) (fmEta Verdict verdictNo)) (fmEta Verdict verdictYes))
def castUsed : Option Box := bind pAppend (fun (p : Proposal) => castBallot p b1 box1)
def decideExact : Option Verdict := bind s0 (fun (s : Polity) => map (fun (t : Count) => decideYes s t) two)
def decideShort : Option Verdict := bind s0 (fun (s : Polity) => map (fun (t : Count) => decideYes s t) one)
def g4Append : Option Count := bind s0 (fun (s : Polity) => bind pAppend (fun (p : Proposal) => map (fun (t : Count) => tAppend (stepD s (pair p t))) two))
def g4Refused : Option Count := bind s0 (fun (s : Polity) => bind pAppend (fun (p : Proposal) => map (fun (t : Count) => tAppend (stepD s (pair p t))) one))
def g5Open : Option Count := bind s0 (fun (s : Polity) => bind pLower (fun (pl : Proposal) => bind pOpen (fun (po : Proposal) =>
  bind two (fun (t : Count) => map (fun (u : Count) => tOpen (amendAll (fmMul Decided (fmEta Decided (pair pl t)) (fmEta Decided (pair po u))) s)) one))))
