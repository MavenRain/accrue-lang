-- A private cast contract (slice S8 B3a, docs/PLAN.md section 8): the ring (p0, p1) of examples/zk.lang at poll 0.
-- The entry cast takes the calldata words choice, c_1, s_1, s_2, I.x, I.y (O28) and passes them to zkVerify. The ring is
-- closed and the words are open, so the zkVerify application stays stuck (S3, Q-S3-12 (a)). zkVerify gives Option Flag
-- (Q-S3-13 (a)) and none reverts. The nullifier key is hash (hash I.x I.y) poll (ruling Q4).
def g : Prod U256 U256 := pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u
def k0 : U256 := zkKey 0
def k1 : U256 := zkKey 1
def p0 : Option (Prod U256 U256) := ecMul g k0
def p1 : Option (Prod U256 U256) := ecMul g k1
def ring : Option (List (Prod U256 U256)) := bind p0 (fun (a : Prod U256 U256) => bind p1 (fun (b : Prod U256 U256) => some (cons a (cons b nil))))
def poll : U256 := 0u

state State := makeState (used : Map U256 Flag) (tally : Map U256 U256)
def init : State := makeState mapEmpty mapEmpty

-- Entry: a used key image reverts, a failed or none verify reverts, else the key image is recorded and the choice counted.
def cast : (env : Env) -> (s : State) -> (choice c1 s1 s2 ix iy : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (choice c1 s1 s2 ix iy : U256) =>
    flagIf (mapGet (used s) (hash (hash ix iy) poll))
      none
      (option none (fun (f : Flag) => flagIf f
        (bind (u256Add (mapGet (tally s) choice) 1u) (fun (t : U256) => some (pair (makeState (mapSet (used s) (hash (hash ix iy) poll) flagYes)
          (mapSet (tally s) choice t)) nil)))
        none)
        (bind ring (fun (rg : List (Prod U256 U256)) => zkVerify rg poll choice (cons c1 (cons s1 (cons s2 (cons ix (cons iy nil))))))))

-- View: the count of a choice.
def count : (env : Env) -> (s : State) -> (choice : U256) -> U256 :=
  fun (env : Env) (s : State) (choice : U256) => mapGet (tally s) choice

-- The host path: the cast of member 0 for choice 1 verifies in the evaluator.
def ok : Option Flag := bind ring (fun (rg : List (Prod U256 U256)) => bind (zkSign rg k0 poll 1u) (fun (sg : List U256) => zkVerify rg poll 1u sg))
