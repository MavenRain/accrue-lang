-- Laws that the checker proves by normalization: each proof is refl.
-- The folds into Nat stay on the kit List (no isSet Nat); mapId uses FreeMon (S3).
def xs : List Nat := cons 1 (cons 2 nil)
def noNats : List Nat := nil
def freeXs : FreeMon Nat := fmCons Nat 1 (fmCons Nat 2 (fmUnit Nat))
def leftFour : Sum Nat Nat := inl 4
def beta : Path (Option Nat) ((fun (n : Nat) => natAdd n n) 6) (some 12) := refl
def eta : Path ((n : Nat) -> Option Nat) (fun (n : Nat) => natAdd n 1) (fun (m : Nat) => natAdd m 1) := refl
def mapId : Path (FreeMon Nat) (fmMap Nat Nat (fun (n : Nat) => n) freeXs) freeXs := refl
def leftUnit : Path (Option Nat) (bind (pure 4) (fun (n : Nat) => natAdd n 1)) (some 5) := refl
def rightUnit : Path (Option Nat) (bind (some 4) (fun (n : Nat) => pure n)) (some 4) := refl
def foldNil : Path (Option Nat) (fold (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd x a)) (some 0) noNats) (some 0) := refl
def foldSum : Path (Option Nat) (fold (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd x a)) (some 0) xs) (some 3) := refl
def firstPair : Path Nat (first (pair 3 flagYes)) 3 := refl
def eitherLeft : Path (Option Nat) (either (fun (n : Nat) => some n) (fun (n : Nat) => natAdd n 1) leftFour) (some 4) := refl
def subNone : Path (Option Nat) (natSub 3 5) none := refl
def flagTrue : Path Nat (flagIf (natLe 2 3) 1 0) 1 := refl
def secondPair : Path Nat (second (pair 3 250)) 250 := refl

-- S3 (Q-S3-4, Q-S3-8): the divisor is a NonZero Nat; a literal other than 0 checks as one.
def divLiteral : Path Nat (natDiv 7 2) 3 := refl
def modLiteral : Path Nat (natMod 7 2) 1 := refl
def nonZeroNone : Path (Option (NonZero Nat)) (nonZero 0) none := refl
def nonZeroDiv : Path (Option Nat) (map (fun (d : NonZero Nat) => natDiv 7 d) (nonZero 2)) (some 3) := refl
def nonZeroBase : Path Nat (nonZeroValue 5) 5 := refl
