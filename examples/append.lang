-- G2 (S7, Q-S7-1 .. Q-S7-7 (a)): the append check of a 2 of 3 committee. A
-- kit file: the keys, the head and the signature words come from
-- build/frosttool (test/frosttool.c). The committee is as dkgtool key_run:
-- 2 of 3, then the reshare to 3 of 4 under the same key. The message is
-- (head r0, 42u), with r0 the empty record. pol has keyAppend kA, and polO
-- has keyAppend kO (another key, so a signature under kA fails).
def kA : Point := 0x3ded4fb781b4977c61b99911b4ac86e631601ffbbe49959b44c6c462ee92bceau
def kO : Point := 0xf7f36a2ad3963a54863980b0ddf4c0cab710f2f1d88e3102eca3ec0429bc67e7u
def pol : Polity := makePolity (fmUnit Point) 2 2 2 kO kA 2 2 kO kA 0
def polO : Polity := makePolity (fmUnit Point) 2 2 2 kA kO 2 2 kA kO 0
def r0 : Record := fmUnit Entry
def r1 : Record := snoc 7u r0
def goodA : Auth := authOf 0x581adab49a06a9997ca9c30c3908ef954ff51e92c0648f348169e2756dc4e029u 0x5c0b47bf4efb292b101fe06d049e11ce3cac04d370e5dbc60196def4e3849bf4u
def badA : Auth := authOf 0x581adab49a06a9997ca9c30c3908ef954ff51e92c0648f348169e2756dc4e029u 0x5c0b47bf4efb292b101fe06d049e11ce3cac04d370e5dbc60196def4e3849bf5u
def a34 : Auth := authOf 0xbd5752e841c6e43cae715bbc9611ae6067ebe484bef8686c5397f35eb6d10711u 0x336fd07a3604019efbaebe0f0caa12563b1dac94e561b267c6ec9a10d1083765u

-- L10 (Q-S7-7 (a)): a good Auth puts the entry at the end of the record.
def l10 : Path (Option Record) (append pol goodA 42u r0) (some (snoc 42u r0)) := refl
-- L11: the same Auth with z + 1 gives none.
def l11 : Path (Option Record) (append pol badA 42u r0) none := refl

-- Eval rows: a good Auth, z + 1, the Auth on another head, on another entry,
-- under the other key, the length and the head after the append, and the
-- 3 of 4 key after the reshare (signers 2, 3 and 4).
def appGood : Option Record := append pol goodA 42u r0
def appBad : Option Record := append pol badA 42u r0
def appHead : Option Record := append pol goodA 42u r1
def appEntry : Option Record := append pol goodA 43u r0
def appOpen : Option Record := append polO goodA 42u r0
def lenAfter : Option Flag := bind (append pol goodA 42u r0) (fun (x : Record) => bind (len Entry x) (fun (n : Count) =>
  map (fun (k : Count) => natEq n k) (bind (len Entry r0) opSucc)))
def headAfter : Option Flag := map (fun (x : Record) => u256Eq (head x) (H3 tagAppend (head r0) 42u)) (append pol goodA 42u r0)
def app34 : Option Record := append pol a34 42u r0
