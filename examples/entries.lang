-- Entries: first-order Nat and Flag definitions. The target exports them.
def addPrice : (a : Nat) -> (b : Nat) -> Option Nat := fun (a : Nat) (b : Nat) => natAdd a b

def ratio : (a : Nat) -> (k : Nat) -> Option Nat :=
  fun (a : Nat) (k : Nat) => map (fun (d : NonZero Nat) => natDiv a d) (nonZero k)

def remainder : (a : Nat) -> (k : Nat) -> Option Nat :=
  fun (a : Nat) (k : Nat) => map (fun (d : NonZero Nat) => natMod a d) (nonZero k)

def discount : (a : Nat) -> (d : Nat) -> Option Nat := fun (a : Nat) (d : Nat) => natSub a d

def cheap : (a : Nat) -> Flag := fun (a : Nat) => natLe a 100

def square : (n : Nat) -> Option Nat :=
  fun (n : Nat) => fold (fun (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a n)) (some 0) n

def pick : (f : Flag) -> (a : Nat) -> (b : Nat) -> Nat :=
  fun (f : Flag) (a : Nat) (b : Nat) => flagIf f a b
