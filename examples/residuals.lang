-- Entries for the K4b lowering: none, a revert, a history add, mapGet and mapSet, Addr and Flag arguments.
state State := makeState (owner : Addr) (held : U256) history (earned : U256) (count : Nat) (book : Map Nat U256)

def init : State := makeState 0x00000000000000000000000000000000000000aa 0u 0u 0 mapEmpty

-- Entry: always revert with empty data (none).
def refuse : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) => none

-- Entry: always revert (a division by 0: nonZero 0 gives none).
def crash : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) =>
    bind (nonZero 0) (fun (d : NonZero Nat) => some (pair (makeState (owner s) (toU256 (natDiv 7 d)) (earned s) (count s) (book s)) nil))

-- Entry: add to the history field earned and count the calls.
def earn : (env : Env) -> (s : State) -> (x : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (x : U256) =>
    bind (natAdd (count s) 1) (fun (c : Nat) => bind (u256Add (earned s) x) (fun (e : U256) => some (pair (makeState (owner s) (held s) e c (book s)) nil)))

-- Entry: put a value in the book, then add the value at another key to held.
def file : (env : Env) -> (s : State) -> (k : Nat) -> (v : U256) -> (j : Nat) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (k : Nat) (v : U256) (j : Nat) =>
    bind (u256Add (held s) (mapGet (book s) j)) (fun (h : U256) => some (pair (makeState (owner s) h (earned s) (count s) (mapSet (book s) k v)) nil))

-- Entry: the caller is the owner and count is not 0, else none (natSub 0 1 is none).
def own : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) =>
    flagIf (addrEq (caller env) (owner s))
      (bind (natSub (count s) 1) (fun (c : Nat) => some (pair (makeState (owner s) (flagIf (u256Le (held s) 5u) (held s) 5u) (earned s) c (book s)) nil)))
      none

-- Entry: if the flag is yes, the address becomes the owner, else none.
def mark : (env : Env) -> (s : State) -> (a : Addr) -> (f : Flag) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (a : Addr) (f : Flag) =>
    flagIf f
      (some (pair (makeState a (held s) (earned s) (count s) (book s)) nil))
      none
