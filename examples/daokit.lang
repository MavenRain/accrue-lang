def ring : List (Prod U256 U256) := cons (pair p0x p0y) (cons (pair p1x p1y) (cons (pair p2x p2y) nil))

def gen : Prod U256 U256 := pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

-- -G = (n - 1) G = (Gx, p - Gy).
def negG : Prod U256 U256 := pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0xb7c52588d95c3b9aa25b0403f1eef75702e84bb7597aabe663b82f6f04ef2777u

def maxWord : U256 := 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu

def pointEq : (p q : Prod U256 U256) -> Flag :=
  fun (p q : Prod U256 U256) => flagIf (u256Eq (first p) (first q)) (u256Eq (second p) (second q)) flagNo

-- z P = A + e Q: 2 ecMul, 1 ecAdd. A none point gives flagNo (S3 P4a).
def holds : (p a q : Prod U256 U256) -> (z e : U256) -> Flag :=
  fun (p a q : Prod U256 U256) (z e : U256) =>
    option flagNo (fun (l : Prod U256 U256) => option flagNo (fun (r : Prod U256 U256) => pointEq l r)
      (bind (ecMul q e) (fun (t : Prod U256 U256) => ecAdd a t))) (ecMul p z)

def randChallenge : (ctx pkx pky c1x c1y c2x c2y m ax ay bx by : U256) -> U256 :=
  fun (ctx pkx pky c1x c1y c2x c2y m ax ay bx by : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash randTag ctx) pkx) pky) c1x) c1y) c2x) c2y) m) ax) ay) bx) by

def orChallenge : (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y : U256) -> U256 :=
  fun (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash onehotTag ctx) j) pkx) pky) c1x) c1y) c2x) c2y) a0x) a0y) b0x) b0y) a1x) a1y) b1x) b1y

def randWith : (pkx pky c1x c1y c2x c2y m ax ay bx by z e : U256) -> Flag :=
  fun (pkx pky c1x c1y c2x c2y m ax ay bx by z e : U256) =>
    flagIf (holds gen (pair ax ay) (pair c1x c1y) z e)
      (option flagNo (fun (q : Prod U256 U256) => holds (pair pkx pky) (pair bx by) q z e)
        (bind (ecMul negG m) (fun (t : Prod U256 U256) => ecAdd (pair c2x c2y) t)))
      flagNo

def rand : (ctx pkx pky c1x c1y c2x c2y m ax ay bx by z : U256) -> Flag :=
  fun (ctx pkx pky c1x c1y c2x c2y m ax ay bx by z : U256) =>
    randWith pkx pky c1x c1y c2x c2y m ax ay bx by z (randChallenge ctx pkx pky c1x c1y c2x c2y m ax ay bx by)

-- e0 + e1 = e modulo 2^256, as the host split. u256Add gives none on an
-- overflow and about one honest split in two wraps, so the check uses no
-- add: e1 = e - e0 when e0 <= e, else e1 - 1 = maxWord - (e0 - e) with
-- e1 >= 1. Each u256Sub of a taken branch is some; a none gives flagNo.
def splitOk : (e e0 e1 : U256) -> Flag :=
  fun (e e0 e1 : U256) =>
    flagIf (u256Le e0 e) (option flagNo (fun (d : U256) => u256Eq d e1) (u256Sub e e0))
      (flagIf (u256Le 1u e1)
        (option flagNo (fun (f : Flag) => f) (bind (u256Sub e1 1u) (fun (d : U256) => map (fun (w : U256) => u256Eq d w) (bind (u256Sub e0 e) (fun (v : U256) => u256Sub maxWord v)))))
        flagNo)

def slotWith : (pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 e : U256) -> Flag :=
  fun (pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 e : U256) =>
    flagIf (splitOk e e0 e1)
      (flagIf (holds gen (pair a0x a0y) (pair c1x c1y) z0 e0)
        (flagIf (holds (pair pkx pky) (pair b0x b0y) (pair c2x c2y) z0 e0)
          (flagIf (holds gen (pair a1x a1y) (pair c1x c1y) z1 e1)
            (option flagNo (fun (q : Prod U256 U256) => holds (pair pkx pky) (pair b1x b1y) q z1 e1) (ecAdd (pair c2x c2y) negG))
            flagNo)
          flagNo)
        flagNo)
      flagNo

def slot : (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) -> Flag :=
  fun (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) =>
    slotWith pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1
      (orChallenge ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y)
def challenge : (pkx pky cx cy dx dy ax ay bx by : U256) -> U256 :=
  fun (pkx pky cx cy dx dy ax ay bx by : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash dleqTag pkx) pky) cx) cy) dx) dy) ax) ay) bx) by


def dleqWith : (pkx pky cx cy dx dy ax ay bx by z e : U256) -> Flag :=
  fun (pkx pky cx cy dx dy ax ay bx by z e : U256) =>
    flagIf (holds gen (pair ax ay) (pair pkx pky) z e)
      (holds (pair cx cy) (pair bx by) (pair dx dy) z e)
      flagNo

def dleq : (pkx pky cx cy dx dy ax ay bx by z : U256) -> Flag :=
  fun (pkx pky cx cy dx dy ax ay bx by z : U256) =>
    dleqWith pkx pky cx cy dx dy ax ay bx by z (challenge pkx pky cx cy dx dy ax ay bx by)

def opens : (ux uy vx vy n : U256) -> Flag :=
  fun (ux uy vx vy n : U256) => option flagNo (fun (q : Prod U256 U256) => pointEq (pair ux uy) q)
    (bind (ecMul (pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u) n) (fun (t : Prod U256 U256) => ecAdd t (pair vx vy)))

def ctxOf : (ix iy : U256) -> U256 :=
  fun (ix iy : U256) => hash (hash (hash ballotTag ix) iy) poll

def sumWith : (ctx : U256) -> (c1 c2 : Option (Prod U256 U256)) -> (ax ay bx by z : U256) -> Flag :=
  fun (ctx : U256) (c1 c2 : Option (Prod U256 U256)) (ax ay bx by z : U256) =>
    option flagNo (fun (p : Prod U256 U256) => option flagNo (fun (q : Prod U256 U256) =>
      rand ctx pkx pky (first p) (second p) (first q) (second q) 1u ax ay bx by z) c2) c1

def digestOf : (u1x u1y u2x u2y v1x v1y v2x v2y : U256) -> U256 :=
  fun (u1x u1y u2x u2y v1x v1y v2x v2y : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash digestTag u1x) u1y) u2x) u2y) v1x) v1y) v2x) v2y

def sigOk : (u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 ix iy : U256) -> Flag :=
  fun (u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 ix iy : U256) =>
    option flagNo (fun (f : Flag) => f)
      (zkVerify ring poll (digestOf u1x u1y u2x u2y v1x v1y v2x v2y) (cons c1 (cons s1 (cons s2 (cons s3 (cons ix (cons iy nil)))))))

-- The ctx of a key image: 3 hash.

def sum3 : (p q r : Prod U256 U256) -> Option (Prod U256 U256) :=
  fun (p q r : Prod U256 U256) => bind (ecAdd p q) (fun (t : Prod U256 U256) => ecAdd t r)

def openSum : (c1 c2 : Prod U256 U256) -> (cx cy ex ey d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) -> Flag :=
  fun (c1 c2 : Prod U256 U256) (cx cy ex ey d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) =>
    flagIf (pointEq c1 (pair cx cy))
      (flagIf (pointEq c2 (pair ex ey))
        (flagIf (dleq k1x k1y cx cy d1x d1y a1x a1y b1x b1y z1)
          (flagIf (dleq k2x k2y cx cy d2x d2y a2x a2y b2x b2y z2)
            (option flagNo (fun (q : Prod U256 U256) => pointEq (pair ex ey) q)
              (bind (ecMul gen m) (fun (u : Prod U256 U256) => bind (ecMul (pair d1x d1y) l1) (fun (v : Prod U256 U256) =>
                bind (ecMul (pair d2x d2y) l2) (fun (w : Prod U256 U256) => bind (ecAdd v w) (fun (t : Prod U256 U256) => ecAdd u t))))))
            flagNo)
          flagNo)
        flagNo)
      flagNo


-- The nullifier of a key image and the first pend index of slot j (4 j).
def nullOf : (ix iy : U256) -> U256 :=
  fun (ix iy : U256) => hash (hash ix iy) poll
def slotBase : (j : U256) -> Option U256 :=
  fun (j : U256) => bind (u256Add j j) (fun (d : U256) => u256Add d d)
-- The kept point at pend index k and k + 1 of N.
def kept : (p : Map U256 U256) -> (n k : U256) -> Option (Prod U256 U256) :=
  fun (p : Map U256 U256) (n k : U256) => map (fun (k1 : U256) => pair (mapGet p (hash n k)) (mapGet p (hash n k1))) (u256Add k 1u)

-- Entry castSig (14 words): N not used, the ring signature, then the 8 words to pend and the stage of N reset.
def castSig : (env : Env) -> (s : State) -> (ix iy u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (ix iy u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 : U256) =>
    flagIf (mapGet (used s) (nullOf ix iy))
      none
      (flagIf (sigOk u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 ix iy)
        (bind (u256Add (seq s) 1u) (fun (q : U256) => some (pair (makeState (used s)
          (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (pend s)
            (hash (nullOf ix iy) 0u) u1x) (hash (nullOf ix iy) 1u) u1y) (hash (nullOf ix iy) 2u) u2x) (hash (nullOf ix iy) 3u) u2y)
            (hash (nullOf ix iy) 4u) v1x) (hash (nullOf ix iy) 5u) v1y) (hash (nullOf ix iy) 6u) v2x) (hash (nullOf ix iy) 7u) v2y)
          (mapSet (mapSet (mapSet (stage s) (nullOf ix iy) 1u) (hash (nullOf ix iy) 0u) 0u) (hash (nullOf ix iy) 1u) 0u)
          (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
          (casts s) (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) q) nil)))
        none)

-- Entry castSlot (15 words): N has a castSig, j is 0 or 1, the OR proof of slot j on the kept words, then the flag of slot j.
def castSlot : (env : Env) -> (s : State) -> (ix iy j a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (ix iy j a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) =>
    flagIf (u256Eq (mapGet (stage s) (nullOf ix iy)) 1u)
      (flagIf (u256Le j 1u)
        (bind (slotBase j) (fun (b : U256) => bind (u256Add b 2u) (fun (b2 : U256) =>
          bind (kept (pend s) (nullOf ix iy) b) (fun (qa : Prod U256 U256) => bind (kept (pend s) (nullOf ix iy) b2) (fun (qb : Prod U256 U256) =>
            flagIf (slot (ctxOf ix iy) j pkx pky (first qa) (second qa) (first qb) (second qb)
                a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1)
              (bind (u256Add (seq s) 1u) (fun (q : U256) => some (pair (makeState (used s) (pend s) (mapSet (stage s) (hash (nullOf ix iy) j) 1u)
                (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
                (casts s) (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) q) nil)))
              none)))))
        none)
      none

-- The state after a seal: N used, the slot points added to T0 and T1 (a0 b0 slot 0 c1 c2, a1 b1 slot 1), casts + 1.
-- A none point (off the curve) gives none (S3 P4a).
def afterSeal : (s : State) -> (n : U256) -> (a0 b0 a1 b1 : Option (Prod U256 U256)) -> Option State :=
  fun (s : State) (n : U256) (a0 b0 a1 b1 : Option (Prod U256 U256)) =>
    bind a0 (fun (p0 : Prod U256 U256) => bind b0 (fun (r0 : Prod U256 U256) =>
    bind a1 (fun (p1 : Prod U256 U256) => bind b1 (fun (r1 : Prod U256 U256) =>
    bind (u256Add (casts s) 1u) (fun (c : U256) => bind (u256Add (seq s) 1u) (fun (q : U256) =>
      some (makeState (mapSet (used s) n flagYes) (pend s) (stage s)
        (first p0) (second p0) (first r0) (second r0) (first p1) (second p1) (first r1) (second r1)
        c (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) q)))))))

-- Entry castSeal (7 words): N not used, both slot flags, seq <= castEnd, the sum proof on the kept slots, then the tally add.
def castSeal : (env : Env) -> (s : State) -> (ix iy ax ay bx by z : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (ix iy ax ay bx by z : U256) =>
    flagIf (mapGet (used s) (nullOf ix iy))
      none
      (flagIf (u256Eq (mapGet (stage s) (nullOf ix iy)) 1u)
        (flagIf (u256Eq (mapGet (stage s) (hash (nullOf ix iy) 0u)) 1u)
          (flagIf (u256Eq (mapGet (stage s) (hash (nullOf ix iy) 1u)) 1u)
            (flagIf (u256Le (seq s) (castEnd s))
              (bind (kept (pend s) (nullOf ix iy) 0u) (fun (q0 : Prod U256 U256) => bind (kept (pend s) (nullOf ix iy) 2u) (fun (q2 : Prod U256 U256) =>
                bind (kept (pend s) (nullOf ix iy) 4u) (fun (q4 : Prod U256 U256) => bind (kept (pend s) (nullOf ix iy) 6u) (fun (q6 : Prod U256 U256) =>
                  flagIf (sumWith (ctxOf ix iy) (ecAdd q0 q4) (ecAdd q2 q6) ax ay bx by z)
                    (bind (afterSeal s (nullOf ix iy)
                        (ecAdd (pair (t0ax s) (t0ay s)) q0) (ecAdd (pair (t0bx s) (t0by s)) q2)
                        (ecAdd (pair (t1ax s) (t1ay s)) q4) (ecAdd (pair (t1bx s) (t1by s)) q6))
                      (fun (t : State) => some (pair t nil)))
                    none)))))
              none)
            none)
          none)
        none)

-- The reactor contract (examples/reactor.lang, S10R): its entry transfer sets its window when the caller is
-- this DAO (Q-S11-2 (a)). The window after enactKit: the proposal when yes = m > no = casts - m.
def reactor : Addr := 0x0000000000000000000000000072656163746f72
def nextWindow : (s : State) -> (m : U256) -> Option U256 :=
  fun (s : State) (m : U256) => map (fun (rest : U256) => flagIf (u256Le m rest) (window s) (proposal s)) (u256Sub (casts s) m)

-- The event of enactKit (S5 O15): the reactor and the new window.
event Enacted (target : Addr) (window : U256)

-- Entry enactKit (15 words): seq > castEnd, not enacted, m <= casts, the opening of T0 (two DLEQ shares of {1, 2}),
-- then the window moves to nextWindow, enacted is set, and the event Enacted logs the reactor and the new
-- window (S5 O15: Out has no token transfer).
def enactKit : (env : Env) -> (s : State) -> (d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) =>
    flagIf (u256Le (seq s) (castEnd s))
      none
      (flagIf (enacted s)
        none
        (flagIf (u256Le m (casts s))
          (flagIf (openSum (pair (t0ax s) (t0ay s)) (pair (t0bx s) (t0by s)) (t0ax s) (t0ay s) (t0bx s) (t0by s)
                d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m)
            (bind (nextWindow s m) (fun (w : U256) => bind (u256Add (seq s) 1u) (fun (q : U256) =>
              some (pair (makeState (used s) (pend s) (stage s)
                (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
                (casts s) (castEnd s) (proposal s) w
                flagYes (keys s) (fills s) q) (cons (Enacted reactor w) nil)))))
            none)
          none))

-- Views: the tally word k (T0 c1x c1y c2x c2y, then T1), the window, the casts, the stage of N (1 castSig, + 2 slot 0, + 4 slot 1).
def tallyWord : (env : Env) -> (s : State) -> (k : U256) -> U256 :=
  fun (env : Env) (s : State) (k : U256) =>
    flagIf (u256Eq k 0u) (t0ax s) (flagIf (u256Eq k 1u) (t0ay s) (flagIf (u256Eq k 2u) (t0bx s) (flagIf (u256Eq k 3u) (t0by s)
      (flagIf (u256Eq k 4u) (t1ax s) (flagIf (u256Eq k 5u) (t1ay s) (flagIf (u256Eq k 6u) (t1bx s) (t1by s)))))))
def windowNow : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => window s
def castCount : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => casts s
def stageOf : (env : Env) -> (s : State) -> (ix iy : U256) -> Option U256 :=
  fun (env : Env) (s : State) (ix iy : U256) =>
    bind (u256Add (mapGet (stage s) (hash (nullOf ix iy) 0u)) (mapGet (stage s) (hash (nullOf ix iy) 0u))) (fun (b2 : U256) =>
      bind (u256Add (mapGet (stage s) (hash (nullOf ix iy) 1u)) (mapGet (stage s) (hash (nullOf ix iy) 1u))) (fun (c2 : U256) =>
        bind (u256Add c2 c2) (fun (c4 : U256) => bind (u256Add b2 c4) (fun (r : U256) => u256Add (mapGet (stage s) (nullOf ix iy)) r))))

-- Eval rows (test/eval/expect.txt): the 3 casts (ops 1 to 12), one more op (reslot), then enactKit at seq 13 > castEnd.
def e0 : Env := makeEnv 0x00000000000000000000000000000000000000aa
def v0sig : Option (Prod State (List Out)) := castSig e0 init b0ix b0iy b0j0c1x b0j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3
def v0slots : Option (Prod State (List Out)) := bind v0sig (fun (r : Prod State (List Out)) =>
  bind (castSlot e0 (first r) b0ix b0iy 0u b0j0a0x b0j0a0y b0j0b0x b0j0b0y b0j0a1x b0j0a1y b0j0b1x b0j0b1y b0j0e0 b0j0e1 b0j0z0 b0j0z1) (fun (q : Prod State (List Out)) =>
    castSlot e0 (first q) b0ix b0iy 1u b0j1a0x b0j1a0y b0j1b0x b0j1b0y b0j1a1x b0j1a1y b0j1b1x b0j1b1y b0j1e0 b0j1e1 b0j1z0 b0j1z1))
def v0 : Option (Prod State (List Out)) := bind v0slots (fun (r : Prod State (List Out)) => castSeal e0 (first r) b0ix b0iy b0sumax b0sumay b0sumbx b0sumby b0sumz)
def v1 : Option (Prod State (List Out)) := bind v0 (fun (r : Prod State (List Out)) =>
  bind (castSig e0 (first r) b1ix b1iy b1j0c1x b1j0c1y b1j0c2x b1j0c2y b1j1c1x b1j1c1y b1j1c2x b1j1c2y b1c1 b1s1 b1s2 b1s3) (fun (a : Prod State (List Out)) =>
    bind (castSlot e0 (first a) b1ix b1iy 0u b1j0a0x b1j0a0y b1j0b0x b1j0b0y b1j0a1x b1j0a1y b1j0b1x b1j0b1y b1j0e0 b1j0e1 b1j0z0 b1j0z1) (fun (b : Prod State (List Out)) =>
      bind (castSlot e0 (first b) b1ix b1iy 1u b1j1a0x b1j1a0y b1j1b0x b1j1b0y b1j1a1x b1j1a1y b1j1b1x b1j1b1y b1j1e0 b1j1e1 b1j1z0 b1j1z1) (fun (c : Prod State (List Out)) =>
        castSeal e0 (first c) b1ix b1iy b1sumax b1sumay b1sumbx b1sumby b1sumz))))
def v2slots : Option (Prod State (List Out)) := bind v1 (fun (r : Prod State (List Out)) =>
  bind (castSig e0 (first r) b2ix b2iy b2j0c1x b2j0c1y b2j0c2x b2j0c2y b2j1c1x b2j1c1y b2j1c2x b2j1c2y b2c1 b2s1 b2s2 b2s3) (fun (a : Prod State (List Out)) =>
    bind (castSlot e0 (first a) b2ix b2iy 0u b2j0a0x b2j0a0y b2j0b0x b2j0b0y b2j0a1x b2j0a1y b2j0b1x b2j0b1y b2j0e0 b2j0e1 b2j0z0 b2j0z1) (fun (b : Prod State (List Out)) =>
      castSlot e0 (first b) b2ix b2iy 1u b2j1a0x b2j1a0y b2j1b0x b2j1b0y b2j1a1x b2j1a1y b2j1b1x b2j1b1y b2j1e0 b2j1e1 b2j1z0 b2j1z1)))
def v2 : Option (Prod State (List Out)) := bind v2slots (fun (c : (Prod State (List Out))) =>
  castSeal e0 (first c) b2ix b2iy b2sumax b2sumay b2sumbx b2sumby b2sumz)
-- One more op: voter 2 casts slot 1 again. The state keeps its words; only seq moves.
def reslot : (s : State) -> Option (Prod State (List Out)) :=
  fun (s : State) => castSlot e0 s b2ix b2iy 1u b2j1a0x b2j1a0y b2j1b0x b2j1b0y b2j1a1x b2j1a1y b2j1b1x b2j1b1y b2j1e0 b2j1e1 b2j1z0 b2j1z1
def v2late : Option (Prod State (List Out)) := bind v2 (fun (r : (Prod State (List Out))) => reslot (first r))
def openWith : (m : U256) -> (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (m : U256) (env : Env) (s : State) => enactKit env s tyd1x tyd1y tya1x tya1y tyb1x tyb1y tyz1 tyd2x tyd2y tya2x tya2y tyb2x tyb2y tyz2 m
def stageSig : Option U256 := bind v0sig (fun (r : Prod State (List Out)) => stageOf e0 (first r) b0ix b0iy)
def stageSlots : Option U256 := bind v0slots (fun (r : Prod State (List Out)) => stageOf e0 (first r) b0ix b0iy)
def tallyHost : Option Flag := map (fun (r : Prod State (List Out)) =>
  flagIf (u256Eq (tallyWord e0 (first r) 0u) tyc1x) (flagIf (u256Eq (tallyWord e0 (first r) 1u) tyc1y)
    (flagIf (u256Eq (tallyWord e0 (first r) 2u) tyc2x) (u256Eq (tallyWord e0 (first r) 3u) tyc2y) flagNo) flagNo) flagNo) v2
def castsAfter : Option U256 := map (fun (r : Prod State (List Out)) => castCount e0 (first r)) v2
def recast : Option (Prod State (List Out)) := bind v0 (fun (r : Prod State (List Out)) => castSig e0 (first r) b0ix b0iy b0j0c1x b0j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3)
def sealEarly : Option (Prod State (List Out)) := bind v0sig (fun (r : Prod State (List Out)) => castSeal e0 (first r) b0ix b0iy b0sumax b0sumay b0sumbx b0sumby b0sumz)
-- sealLate: two more ops after the slots of voter 2, so its castSeal comes at seq 13 > castEnd 12.
def sealLate : Option (Prod State (List Out)) := bind (bind v2slots (fun (r : (Prod State (List Out))) => reslot (first r))) (fun (a : (Prod State (List Out))) =>
  bind (reslot (first a)) (fun (b : (Prod State (List Out))) => castSeal e0 (first b) b2ix b2iy b2sumax b2sumay b2sumbx b2sumby b2sumz))
-- enactEarly: enactKit at seq 12 (not > castEnd 12).
def enactEarly : Option (Prod State (List Out)) := bind v2 (fun (r : Prod State (List Out)) => openWith 2u e0 (first r))
def enactM3 : Option (Prod State (List Out)) := bind v2late (fun (r : Prod State (List Out)) => openWith 3u e0 (first r))
def windowAfter : Option U256 := map (fun (q : Prod State (List Out)) => windowNow e0 (first q)) (bind v2late (fun (r : Prod State (List Out)) => openWith 2u e0 (first r)))
def enactPay : Option (List Out) := map (fun (q : Prod State (List Out)) => second q) (bind v2late (fun (r : Prod State (List Out)) => openWith 2u e0 (first r)))
def enactTwice : Option (Prod State (List Out)) := bind (bind v2late (fun (r : Prod State (List Out)) => openWith 2u e0 (first r))) (fun (q : Prod State (List Out)) => openWith 2u e0 (first q))
