-- The trace position (S3, USER ruling Q-S3-3 (a)): `len A r` counts the
-- ops of the trace r : FreeMon A, and a position is a Count.
def lenEmpty : Count := len Size (fmUnit Size)
def lenOne : Count := len Size (fmCons Size sz0 (fmUnit Size))
def lenTwo : Count := len Size (fmMul Size (fmCons Size sz0 (fmUnit Size)) (fmCons Size (szS sz0) (fmUnit Size)))
