-- Formers F6 and F7: fold over Nat and List; unfold with a step limit.
-- These rows stay on the kit List (S3): a fold of FreeMon into Nat needs
-- isSet Nat, sumTo feeds ones to sumList, and unfold has no FreeMon form.
def sumList : (xs : List Nat) -> Option Nat :=
  fun (xs : List Nat) => fold (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd x a)) (some 0) xs
def square : (n : Nat) -> Option Nat := fun (n : Nat) => fold (fun (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a n)) (some 0) n
def ones : (n : Nat) -> List Nat := fun (n : Nat) => fold (fun (acc : List Nat) => cons 1 acc) nil n
def lengthOf : (xs : List Nat) -> Option Nat := fun (xs : List Nat) => fold (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a 1)) (some 0) xs
def sumTo : Option Nat := sumList (ones 3)
def down : List Nat := unfold (fun (n : Nat) => map (fun (m : Nat) => pair n m) (natSub n 1)) 3 5
def stop : List Nat := unfold (fun (n : Nat) => none) 3 5
