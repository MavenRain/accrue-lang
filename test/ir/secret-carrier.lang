-- REFUSE_TARGET_SECRET (S9 P4, PLAN O4): a Prod Point DecKey carries a
-- decryption key at run time (first takes the Point out of it). The Wasm
-- build keeps it (D8).
def withKey : Point -> DecKey -> Prod Point DecKey := fun (p : Point) (d : DecKey) => pair p d
def leakCarrier : (n : Nat) -> Point := fun (n : Nat) => first (flagIf (natEq n 0) (withKey 1u (secretEta Scalar (toU256 n))) (withKey 2u (secretEta Scalar 3u)))
