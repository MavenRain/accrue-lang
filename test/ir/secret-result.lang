-- REFUSE_TARGET_SECRET (S9 P4, PLAN O4): nonceOf has a Nonce result that is
-- made at run time from n. An entry result cannot be a Nonce (entry_of), so
-- the result is inner. The Wasm build keeps it (D8).
def nonceOf : (n : Nat) -> Nonce := fun (n : Nat) => secretEta Scalar (toU256 n)

def leakResult : (n : Nat) -> Point :=
  fun (n : Nat) => second (flagIf (natEq n 0) (pair (nonceOf n) 1u) (pair (nonceOf 1) 2u))
