-- REFUSE_TARGET_SECRET (S9 P4, PLAN O4): the closed KeyShare share7 reaches
-- run time in each arm of a flagIf on n. The Wasm build keeps it (D8).
def share7 : KeyShare := secretEta Scalar 7u
def leakConst : (n : Nat) -> Point := fun (n : Nat) => second (flagIf (natEq n 0) (pair share7 1u) (pair share7 2u))
