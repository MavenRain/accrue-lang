-- Proofs over an overflow. At n = 18446744073709551615 natAdd overflows and
-- gives none (A has no trap), so `evidence n` takes the none path of option,
-- and each entry reads its path at i1, so the none path reaches the result.
-- Each path is refl, so at each n each entry gives 7.
def evidence : Nat -> Path Nat 0 0 :=
  fun n => flagIf (option flagYes (fun (m : Nat) => natEq m 0) (natAdd n 1)) refl refl

def proofMove : Nat -> Nat := fun n => option 0 (fun (r : Nat) => r) (natAdd (evidence n @ i1) 7)

def proofSymm : Nat -> Nat :=
  fun n => option 0 (fun (r : Nat) => r) (natAdd (sym (evidence n) @ i1) 7)

def baseProof : Path Nat 0 0 := refl

def proofTrans : Nat -> Nat :=
  fun n => option 0 (fun (r : Nat) => r) (natAdd (trans Nat 0 0 0 baseProof (evidence n) @ i1) 7)

def proofCong : Nat -> Nat :=
  fun n => option 0 (fun (r : Nat) => r) (natAdd (cong (fun (x : Nat) => x) (evidence n) @ i1) 7)
