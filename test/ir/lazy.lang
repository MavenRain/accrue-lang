-- A lazy trap. The second field of the pair overflows after two steps, but
-- the entry reads only the first field. `langc eval lazy 3` gives 3.
def lazy : (n : Nat) -> Option Nat := fun (n : Nat) => first (fold (fun (p : Prod (Option Nat) Nat) => pair (bind (first p) (fun (a : Nat) => natAdd a 1)) (natMul (second p) 18446744073709551615)) (pair (some 0) 2) n)
