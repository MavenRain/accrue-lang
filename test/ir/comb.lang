-- The binary node lowerings (cairn-lang S8, Q-S8-10, Q-S8-11). Each fmMul
-- here has a static fmEta on one side (snoc: right, cons: left, mix: both).
-- fmChain reads a record left to right and fmRun right to left; the digit
-- fold 3d + a is not symmetric, so a swapped side or order gives a different
-- value. The gate compares langc eval results. natAdd gives Option Nat, so
-- each digit step takes it apart with bind and option (default 0), and
-- snocLen takes the Option Nat of len apart with option.
-- Each fold has the literal count 3 and the leaf n (S8 P3, Q-S8-15 (a));
-- the forms with the count n are in test/ir/capacity.lang.
def snocs : (n : Nat) -> FreeMon Nat := fun (n : Nat) => fold (fun (m : FreeMon Nat) => fmMul Nat (fmMul Nat m (fmEta Nat 1)) (fmEta Nat n)) (fmUnit Nat) 3
def conses : (n : Nat) -> FreeMon Nat := fun (n : Nat) => fold (fun (m : FreeMon Nat) => fmMul Nat (fmEta Nat 3) (fmMul Nat (fmEta Nat n) m)) (fmUnit Nat) 3
def mixes : (n : Nat) -> FreeMon Nat := fun (n : Nat) => fold (fun (m : FreeMon Nat) => fmMul Nat (fmEta Nat 1) (fmMul Nat m (fmEta Nat n))) (fmUnit Nat) 3
def snocChain : (n : Nat) -> Nat := fun (n : Nat) => fmChain Nat Nat natIsSet (fun (d : Nat) (a : Nat) => option 0 (fun (r : Nat) => r) (bind (natAdd d d) (fun (e : Nat) => bind (natAdd e d) (fun (f : Nat) => natAdd f a)))) 0 (snocs n)
def snocRun : (n : Nat) -> Nat := fun (n : Nat) => fmRun Nat Nat natIsSet (fun (a : Nat) (d : Nat) => option 0 (fun (r : Nat) => r) (bind (natAdd d d) (fun (e : Nat) => bind (natAdd e d) (fun (f : Nat) => natAdd f a)))) 0 (snocs n)
def consChain : (n : Nat) -> Nat := fun (n : Nat) => fmChain Nat Nat natIsSet (fun (d : Nat) (a : Nat) => option 0 (fun (r : Nat) => r) (bind (natAdd d d) (fun (e : Nat) => bind (natAdd e d) (fun (f : Nat) => natAdd f a)))) 0 (conses n)
def consRun : (n : Nat) -> Nat := fun (n : Nat) => fmRun Nat Nat natIsSet (fun (a : Nat) (d : Nat) => option 0 (fun (r : Nat) => r) (bind (natAdd d d) (fun (e : Nat) => bind (natAdd e d) (fun (f : Nat) => natAdd f a)))) 0 (conses n)
def mixChain : (n : Nat) -> Nat := fun (n : Nat) => fmChain Nat Nat natIsSet (fun (d : Nat) (a : Nat) => option 0 (fun (r : Nat) => r) (bind (natAdd d d) (fun (e : Nat) => bind (natAdd e d) (fun (f : Nat) => natAdd f a)))) 0 (mixes n)
def mixRun : (n : Nat) -> Nat := fun (n : Nat) => fmRun Nat Nat natIsSet (fun (a : Nat) (d : Nat) => option 0 (fun (r : Nat) => r) (bind (natAdd d d) (fun (e : Nat) => bind (natAdd e d) (fun (f : Nat) => natAdd f a)))) 0 (mixes n)
def snocLen : (n : Nat) -> Nat := fun (n : Nat) => option 0 (fun (k : Nat) => k) (len Nat (snocs n))
