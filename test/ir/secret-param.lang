-- REFUSE_TARGET_SECRET (S9 P4, Q-S9-4 (a), PLAN O4): keepShare has a KeyShare
-- param, and the flagIf on n keeps its pair at run time, so the share has a
-- run-time payload. The ES build refuses it. The Wasm build keeps it (D8).
-- An entry param cannot be a KeyShare (entry_of), so the param is inner.
def keepShare : KeyShare -> Point -> Prod KeyShare Point :=
  fun (k : KeyShare) (p : Point) => pair k p

def leakParam : (n : Nat) -> Point :=
  fun (n : Nat) => second (flagIf (natEq n 0) (keepShare (secretEta Scalar (toU256 n)) 1u) (keepShare (secretEta Scalar 2u) 3u))
