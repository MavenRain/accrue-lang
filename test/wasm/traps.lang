-- Overflow flags survive neutral path endpoints and curve calls. A has no
-- trap (rule R0): natAdd, u256Add, ecAdd and ecMul give none, and option
-- takes the none apart. Curve errors in an unused fold-state field stay
-- lazy; a coordinate that overflows gives the none path of the curve call
-- (the default 2^256 - 1) in both the evaluator and the Wasm prelude.
def evidenceN : (n : Nat) -> (x : Nat) -> Path Nat x x := fun n x => flagIf (option flagYes (fun (m : Nat) => natEq m 0) (natAdd n 1)) refl refl
def endN0 : Nat -> Nat -> Nat := fun n x => (evidenceN n x) @ i0
def endN1 : Nat -> Nat -> Nat := fun n x => (evidenceN n x) @ i1
def varProof : Nat -> Nat -> Nat := fun n steps => (fold (fun (p : Path Nat 0 0) => flagIf (natEq (p @ i1) 0) refl refl) (evidenceN n 0) steps) @ i1
def evidenceF : (n : Nat) -> (x : Flag) -> Path Flag x x := fun n x => flagIf (option flagYes (fun (m : Nat) => natEq m 0) (natAdd n 1)) refl refl
def endF : Nat -> Flag -> Flag := fun n x => (evidenceF n x) @ i1
def evidenceYes : Nat -> Path Flag flagYes flagYes := fun n => flagIf (option flagYes (fun (m : Nat) => natEq m 0) (natAdd n 1)) refl refl
def endYes : Nat -> Flag := fun n => (evidenceYes n) @ i0
def evidenceW : (n : Nat) -> (x : U256) -> Path U256 x x := fun n x => flagIf (option flagYes (fun (m : Nat) => natEq m 0) (natAdd n 1)) refl refl
def endW : Nat -> U256 -> U256 := fun n x => (evidenceW n x) @ i1
def evidenceP : (n : Nat) -> (x : Nat) -> Path (Prod Nat Nat) (pair x 9) (pair x 9) := fun n x => flagIf (option flagYes (fun (m : Nat) => natEq m 0) (natAdd n 1)) refl refl
def endP : Nat -> Nat -> Nat := fun n x => first ((evidenceP n x) @ i1)
def lazyAdd : (n : Nat) -> (x : U256) -> (y : U256) -> Nat := fun n x y => first (fold (fun (p : Prod Nat (Option (Prod U256 U256))) => pair (option 0 (fun (m : Nat) => m) (natAdd (first p) 1)) (bind (second p) (fun (q : Prod U256 U256) => ecAdd q (pair x y)))) (pair n (some (pair 0u 0u))) 3)
def lazyMul : (n : Nat) -> (x : U256) -> (y : U256) -> Nat := fun n x y => first (fold (fun (p : Prod Nat (Option (Prod U256 U256))) => pair (option 0 (fun (m : Nat) => m) (natAdd (first p) 1)) (bind (second p) (fun (q : Prod U256 U256) => ecMul (pair x y) (first q)))) (pair n (some (pair 0u 0u))) 3)
def coordAddX : U256 -> U256 := fun x => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => first q) (bind (u256Add x 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu) (fun (w : U256) => ecAdd (pair w 0u) (pair 0u 0u)))
def coordAddY : U256 -> U256 := fun y => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => second q) (bind (u256Add y 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu) (fun (w : U256) => ecAdd (pair 0u 0u) (pair 0u w)))
def coordMulX : U256 -> U256 := fun x => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => first q) (bind (u256Add x 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu) (fun (w : U256) => ecMul (pair w 0u) 1u))
def coordMulY : U256 -> U256 := fun y => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => second q) (bind (u256Add y 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu) (fun (w : U256) => ecMul (pair 0u w) 1u))
