-- ecAdd and ecMul give an Option point (A has no trap, rule R0). Each entry
-- takes the Option apart with option. The none path (a point that is not on
-- the curve or a coordinate equal to p) gives 2^256 - 1, which is not a
-- coordinate, so a none row differs from the point at infinity (0, 0).
def addX : (a : U256) -> (b : U256) -> (c : U256) -> (d : U256) -> U256 :=
  fun (a : U256) (b : U256) (c : U256) (d : U256) => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => first q) (ecAdd (pair a b) (pair c d))

def addY : (a : U256) -> (b : U256) -> (c : U256) -> (d : U256) -> U256 :=
  fun (a : U256) (b : U256) (c : U256) (d : U256) => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => second q) (ecAdd (pair a b) (pair c d))

def mulX : (x : U256) -> (y : U256) -> (k : U256) -> U256 :=
  fun (x : U256) (y : U256) (k : U256) => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => first q) (ecMul (pair x y) k)

def mulY : (x : U256) -> (y : U256) -> (k : U256) -> U256 :=
  fun (x : U256) (y : U256) (k : U256) => option 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu (fun (q : Prod U256 U256) => second q) (ecMul (pair x y) k)

def sigOk : (k : U256) -> (r : U256) -> (z : U256) -> (m : U256) -> (e : U256) -> Flag :=
  fun (k : U256) (r : U256) (z : U256) (m : U256) (e : U256) => schnorrOk k r z m e
